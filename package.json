{
	"name": "@iangregsondev/shelf",
	"version": "0.1.3",
	"description": "A global cache of code reference repositories for AI agents",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/iangregsondev/shelf.git"
	},
	"bin": {
		"shelf": "./src/startup/index.ts"
	},
	"files": [
		"src/**/*.ts"
	],
	"type": "module",
	"scripts": {
		"test": "vp test",
		"format": "vp fmt src tests",
		"format:check": "vp fmt --check src tests",
		"lint": "vp lint --tsconfig tsconfig.json src tests",
		"lint:fix": "vp lint --fix --tsconfig tsconfig.json src tests",
		"check": "vp check",
		"fix": "vp fmt src tests && vp lint --fix --tsconfig tsconfig.json src tests"
	},
	"dependencies": {
		"@effect/platform-node": "4.0.4",
		"effect": "4.0.4"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"typescript": "7.0.2",
		"vite-plus": "catalog:",
		"yaml": "2.9.1"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.11.2",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "^24.0.0",
			"onFail": "download"
		}
	}
}
