{
  "name": "@iangregsondev/shelf",
  "version": "0.1.3",
  "description": "A global cache of code reference repositories for AI agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iangregsondev/shelf.git"
  },
  "bin": {
    "shelf": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "shelf": "node dist/index.mjs",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.4",
    "effect": "4.0.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.4",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "yaml": "2.9.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  }
